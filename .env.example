# AOCG AI Офис — бэкенд · шаблон переменных окружения
#
# Скопировать в .env для локальной разработки и заполнить значения.
# Боевые значения живут в панели Timeweb Cloud:
#     App Platform → AOCG-AI-001_app_prod → Переменные.
# .env НИКОГДА не коммитить (он в .gitignore). Этот файл — можно: в нём нет секретов.
#
# ⚠️ ПРАВИЛО, КУПЛЕННОЕ 24.08.2026 (T61): имена здесь обязаны совпадать
# с тем, что код читает через os.getenv. Сверка показала 11 совпадений
# из 29 — восемнадцать имён были мертвы, восемнадцать отсутствовали.
# Дороже всего обошлось не отсутствие, а ПОДМЕНА ИМЕНИ: хранилище
# описывалось как STORAGE_*, а код читает S3_*. Заполненный шаблон
# давал неработающее хранилище без единой ошибки в журнале.
# Меняешь os.getenv в коде — правь этот файл тем же коммитом.

# ─── База данных ───────────────────────────────────────────────
# Внутренний адрес базы Timeweb. Вид:
#     postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@192.168.0.4:5432/default_db
# Читается в app/database.py:23.
DATABASE_URL=
# Внешний адрес той же базы. Приложению НЕ нужен — им пользуются
# tests/tools/sql_check.py и purge_consents.py с машины разработчика,
# куда внутренний адрес не резолвится.
# DATABASE_PUBLIC_URL=

# ─── Авторизация (JWT) ─────────────────────────────────────────
# ⚠️ ПУСТОЙ JWT_SECRET_KEY = ПРИЛОЖЕНИЕ НЕ СТАРТУЕТ. Так задумано
# (app/auth.py:23-28): подписывать токены угадываемым умолчанием
# опаснее, чем не запуститься. Случайная строка 64 символа.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Почта: Yandex Cloud Postbox (SMTP) ────────────────────────
# Заменил Resend 24.08.2026 (S-74): Resend — сервис США, адреса
# сотрудников уходили за границу. Postbox: серверы в РФ.
# Квота подтверждена в интерфейсе: 200 писем в СУТКИ,
# увеличение — заявкой в поддержку.
#
# Пароль SMTP — НЕ секрет статического ключа: он получается
# отдельным генератором Яндекса. Подставить сам секрет —
# получить отказ авторизации, похожий на «неверный ключ».
#
# Почта включена, только если заданы ВСЕ четыре обязательные.
# Частичная настройка = выключено, и это намеренно.
POSTBOX_SMTP_HOST=
POSTBOX_SMTP_PORT=587
POSTBOX_SMTP_USER=
POSTBOX_SMTP_PASSWORD=
POSTBOX_FROM=AOCG AI Office <noreply@aocgai.ru>

# ─── ФНС: проверка чеков ───────────────────────────────────────
# Пусто → проверка чека пропускается, ввод остаётся ручным.
PROVERKACHEKA_TOKEN=

# ─── Anthropic: распознавание фото чека ────────────────────────
# Пусто → кнопка «Распознать фото» отвечает отказом,
# ручной ввод работает (app/routers/ocr.py:354).
ANTHROPIC_API_KEY=

# ─── Файловое хранилище S3 (Yandex Object Storage) ─────────────
# ⚠️ ИМЕНА НАЧИНАЮТСЯ С S3_, НЕ STORAGE_. Ровно на этом
# шаблон обманывал: app/storage/s3.py:198-202 читает S3_*.
# Не заданы ENDPOINT, BUCKET, ACCESS_KEY или SECRET_KEY —
# хранилище выключено, и это штатное состояние, не ошибка.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-1

# ─── Шлюз MAX (уведомления в рабочий чат) ──────────────────────
# ⚠️ MAX_RELAY_TOKEN — СЕКРЕТ: им открывается /internal/max/send
# снаружи, из Google Apps Script. В шаблоне не упоминался вовсе.
# Пустой MAX_RELAY_TOKEN закрывает ручку для всех.
MAX_RELAY_TOKEN=
MAX_TOKEN=
# chat_id группового чата. ⚠️ У групп он ОТРИЦАТЕЛЬНЫЙ, минус
# обязателен — на потерянном при копировании минусе мы уже стояли (T58).
# ⚠️ Читается ОДИН РАЗ при импорте: после смены нужен перезапуск.
MAX_CHAT_ID=
MAX_API=https://platform-api2.max.ru

# ─── Первый администратор на ПУСТОЙ базе ───────────────────────
# Применяется, только если в таблице users нет ни одной строки
# (app/database.py:96-110). На рабочей базе не делает ничего.
# Пустая почта → засев пропускается: выдуманный администратор
# хуже пустой базы, он выглядит настоящим и переживает миграции.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
BOOTSTRAP_ADMIN_PATRONYMIC=

# ─── Адреса и окружение ────────────────────────────────────────
# APP_URL — адрес ФРОНТА, не API: из него строятся ссылки
# подтверждения почты и приглашений (app/routers/auth.py:166,397).
# ⚠️ В коде умолчанием стоит мёртвый railway-адрес. Не задашь —
# ссылки в письмах уйдут в никуда, и человек увидит не ошибку
# настройки, а «ссылка не открывается». Задавать обязательно.
APP_URL=https://app.aocgai.ru
# Список origin'ов фронта через запятую. Пусто → "*", то есть
# whitelist ВЫКЛЮЧЕН (app/main.py:98-99). Задавать обязательно.
CORS_ORIGINS=https://app.aocgai.ru
# production / staging / local — уходит меткой в Sentry.
ENVIRONMENT=production

# ─── Sentry ────────────────────────────────────────────────────
# Пусто → Sentry выключен, приложение работает как обычно.
# Персональные данные вырезаются белым списком до отправки
# (app/monitoring.py, S-66/S-68/S-69); локальные переменные
# кадров не отправляются вовсе.
SENTRY_DSN=
