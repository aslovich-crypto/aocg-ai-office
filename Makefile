# Команды проекта. Витрина трекера — единственная на сегодня.
#
# ⚠️ ВИТРИНА СОБИРАЕТСЯ В /tmp И В GIT НЕ КЛАДЁТСЯ. Это ПРЕДСТАВЛЕНИЕ,
# а не копия: существует ровно в момент чтения и всегда свежая по
# устройству. Прежняя витрина (артефакт на claude.ai) собиралась руками
# и отстала на два дня — файл правится по семь раз за день.
#
# ⚠️ ПОЧЕМУ НЕ В pre-commit. Хук клал бы готовый HTML в git и вернул
# вторую копию — ровно то, от чего уходим. Плюс каждый коммит трекера
# тащил бы второй изменённый файл, и diff перестал бы читаться:
# правил одну строку — в коммите две тысячи.

PY := venv/bin/python

.PHONY: tracker tracker-check help

## tracker — собрать витрину трекера и открыть в браузере
tracker:
	@$(PY) tests/tools/tracker_html.py
	@open /tmp/aocg-tracker.html 2>/dev/null || \
	 echo "  открыть вручную: /tmp/aocg-tracker.html"

## tracker-check — сверить, что до витрины доехали ВСЕ задачи
tracker-check:
	@$(PY) tests/tools/tracker_html_guard.py

help:
	@grep -E '^## ' Makefile | sed 's/^## /  /'
